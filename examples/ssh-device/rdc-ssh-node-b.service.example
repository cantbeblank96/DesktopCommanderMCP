# Example user service; installing/enabling it is a separate deployment step.
[Unit]
Description=Desktop Commander SSH device node-b
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alice/projects/DesktopCommanderMCP
ExecStart=/home/alice/.local/share/node/bin/node dist/index.js remote --profile node-b --config /home/alice/.config/rdc/node-b.json --non-interactive
Environment=DESKTOP_COMMANDER_DISABLE_TELEMETRY=1
Environment=PATH=/home/alice/.local/share/node/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartPreventExitStatus=64 65 77 78
RestartSec=10
TimeoutStopSec=12
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
